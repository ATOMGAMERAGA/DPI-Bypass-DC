<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon foreground: logo içeriği güvenli bölgeye (safe zone) ölçeklenir.
     Kalkan içi şeffaftır; arka plan gradyan katmanı içeriden görünür.
     ÇİZİM DEĞİŞMEDİ — yalnızca ikon kutusundaki ölçeği ve oturuşu ayarlandı.

     ÖLÇÜLEN DURUM (One UI launcher ekran görüntüsü, kutucuk 208x207 px):
       logo 127x155 px → kutunun %61'i genişlik, %75'i yükseklik
       üst boşluk 35 px, alt boşluk 17 px  → logo AŞAĞI KAYMIŞ, ucu dibe yapışık
     Kaymanın kaynağı önceki translateY=16'ydı: 16/512 * 108dp = 3.375dp, maskenin
     %4.7'si — ölçülen 9 px'lik kaymanın tam karşılığı. "Optik merkezleme" doğru
     fikirdi ama fazla kaçmıştı; mürekkep ağırlık merkezi de merkezin ALTINA
     düşüyordu (+6.8 px).

     YENİ DEĞERLER:
       translateY = 4  → mürekkep ağırlık merkezi maske merkezine oturur
                         (kalkan altta sivrildiği için tam sıfır değil, 4 birim).
       scale = 0.54    → içeriğin merkeze en uzak noktası (kalkanın üst köşesi,
                         merkeze 288.5 birim) 288.5*0.54 = 155.8 birim = 32.9dp
                         yarıçapa iner; 33dp'lik güvenli daireye TAM sığar. Yani
                         hangi maske kullanılırsa kullanılsın köşe kırpılmaz ve
                         logo kutunun içinde nefes alır.

     Monokrom katman (ic_launcher_monochrome) aynı değerleri kullanır; tema
     ikonuna geçildiğinde logo boyut değiştirmemelidir. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="512"
    android:viewportHeight="512">

    <group
        android:scaleX="0.54" android:scaleY="0.54"
        android:pivotX="256" android:pivotY="256"
        android:translateY="4">

        <path
            android:pathData="M256 40 L432 104 V268 C432 372 360 440 256 472 C152 440 80 372 80 268 V104 Z"
            android:strokeWidth="14"
            android:strokeLineJoin="round">
            <aapt:attr name="android:strokeColor">
                <gradient android:type="linear"
                    android:startX="96" android:startY="256" android:endX="416" android:endY="256">
                    <item android:offset="0" android:color="#FF22D3EE" />
                    <item android:offset="1" android:color="#FF3B82F6" />
                </gradient>
            </aapt:attr>
        </path>

        <path
            android:pathData="M244 150 h24 a8 8 0 0 1 8 8 v196 a8 8 0 0 1 -8 8 h-24 a8 8 0 0 1 -8 -8 v-196 a8 8 0 0 1 8 -8 z"
            android:fillColor="#EF4444"
            android:fillAlpha="0.9" />

        <path
            android:pathData="M120 200 L208 200 M304 200 L392 200 M120 256 L196 256 M216 256 L296 256 M316 256 L392 256 M120 312 L208 312 M304 312 L392 312"
            android:strokeWidth="20"
            android:strokeLineCap="round">
            <aapt:attr name="android:strokeColor">
                <gradient android:type="linear"
                    android:startX="96" android:startY="256" android:endX="416" android:endY="256">
                    <item android:offset="0" android:color="#FF22D3EE" />
                    <item android:offset="1" android:color="#FF3B82F6" />
                </gradient>
            </aapt:attr>
        </path>

        <path android:pathData="M372 232 L412 256 L372 280 Z">
            <aapt:attr name="android:fillColor">
                <gradient android:type="linear"
                    android:startX="96" android:startY="256" android:endX="416" android:endY="256">
                    <item android:offset="0" android:color="#FF22D3EE" />
                    <item android:offset="1" android:color="#FF3B82F6" />
                </gradient>
            </aapt:attr>
        </path>
    </group>
</vector>
