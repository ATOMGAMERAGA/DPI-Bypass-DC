<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Uygulama içi UI Compose ile çizilir; bu tema pencere zemini + splash içindir. -->
    <style name="Theme.DPIBypass" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/bg_dark_top</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Android 12+ SplashScreen API: ikon = ferah (küçültülmüş) splash logosu,
         zemin = #0C0F14. Uygulama ikonu yerine ayrı splash_icon kullanılır ki logo
         açılışta çok büyük görünmesin, ikon dairesinin içinde nefes alsın. -->
    <style name="Theme.DPIBypass.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/bg_dark_top</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.DPIBypass</item>
    </style>
</resources>
