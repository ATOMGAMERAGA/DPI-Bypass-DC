# Yerel release imzalama ayarları.
#
# KULLANIM:
#   cp keystore.properties.example keystore.properties
#   ve aşağıdaki dört değeri kendi keystore'una göre doldur.
#
# keystore.properties ve *.jks .gitignore'dadır — ASLA commit'leme.
# Anahtarı kaybedersen aynı uygulamaya güncelleme yayınlayamazsın; yedekle.
# Adım adım kurulum: docs/Imzalama-Rehberi.md

# Keystore dosyasının yolu. Göreli yol app/ klasörüne göre çözülür;
# karışıklık olmasın diye MUTLAK yol yazman önerilir.
storeFile=/home/kullanici/keys/dpibypass-upload.jks

# Keystore (store) parolası
storePassword=BURAYA_STORE_PAROLASI

# Anahtar takma adı (keytool -alias ile verdiğin ad)
keyAlias=dpibypass-upload

# Anahtar parolası (keytool tek parola sorduysa storePassword ile aynıdır)
keyPassword=BURAYA_ANAHTAR_PAROLASI
